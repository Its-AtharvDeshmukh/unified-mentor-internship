generator client {
  provider = "prisma-client-js"
}

// Note: Uses "sqlite" by default so `npm run db:push` works out-of-the-box without external servers.
// Change provider to "postgresql" when connecting to a PostgreSQL instance in production.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  phone             String?
  passwordHash      String
  role              String             @default("USER") // "USER" | "ADMIN"
  holdDurationMs    Int                @default(1800)   // Configurable discreet press-and-hold duration
  shareLiveLocation Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contacts          EmergencyContact[]
  alerts            EmergencyAlert[]

  @@index([email])
}

model EmergencyContact {
  id           String                @id @default(cuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String?
  email        String?
  notifySms    Boolean               @default(true)
  notifyEmail  Boolean               @default(true)
  isVerified   Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  attempts     NotificationAttempt[]

  @@index([userId])
}

model EmergencyAlert {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String                @default("CREATED") // CREATED | PROCESSING | SENT | ACKNOWLEDGED | RESOLVED | FAILED
  idempotencyKey   String                @unique
  shareToken       String                @unique
  shareTokenExpiry DateTime
  triggerNote      String?
  latitude         Float?
  longitude        Float?
  accuracy         Float?
  locationStatus   String                @default("PENDING") // AVAILABLE | UNAVAILABLE | DENIED | PENDING
  lastLocationAt   DateTime?
  triggeredAt      DateTime              @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  resolvedAt       DateTime?
  resolutionNote   String?
  locations        LocationUpdate[]
  notifications    NotificationAttempt[]
  activities       AlertActivity[]

  @@index([userId, status])
  @@index([shareToken])
  @@index([triggeredAt])
}

model LocationUpdate {
  id         String         @id @default(cuid())
  alertId    String
  alert      EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime       @default(now())

  @@index([alertId, recordedAt])
}

model NotificationAttempt {
  id                String            @id @default(cuid())
  alertId           String
  alert             EmergencyAlert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           EmergencyContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  recipientName     String
  channel           String            // "SMS" | "EMAIL" | "IN_APP"
  destination       String
  status            String            @default("PENDING") // PENDING | SENT | DELIVERED_SANDBOX | FAILED
  provider          String            // "SANDBOX" | "TWILIO" | "RESEND"
  providerMessageId String?
  errorMessage      String?
  retryCount        Int               @default(0)
  attemptedAt       DateTime          @default(now())

  @@index([alertId])
}

model AlertActivity {
  id        String         @id @default(cuid())
  alertId   String
  alert     EmergencyAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  actor     String         // "USER" | "SYSTEM" | "CONTACT" | "ADMIN"
  action    String
  details   String
  createdAt DateTime       @default(now())

  @@index([alertId, createdAt])
}

