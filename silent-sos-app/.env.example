# Database Connection
# For fast local evaluation with SQLite, leave as file:./dev.db (and set provider = "sqlite" in schema.prisma)
# For PostgreSQL production/staging: postgresql://postgres:password@localhost:5432/silentsos?schema=public
DATABASE_URL="file:./dev.db"

# Security & Session Signing (Generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-a-secure-32-byte-minimum-secret-key-for-sessions"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Notification Mode: "sandbox" (safe local logging, never texts real numbers) or "production"
NOTIFICATION_MODE="sandbox"

# Optional Live Email Provider (Resend) - Used only when NOTIFICATION_MODE="production"
RESEND_API_KEY="re_placeholder_do_not_commit_real_keys"
EMAIL_FROM="Silent SOS Alert <alerts@yourdomain.com>"

# Optional Live SMS Provider (Twilio) - Used only when NOTIFICATION_MODE="production"
TWILIO_ACCOUNT_SID="AC_placeholder_sid"
TWILIO_AUTH_TOKEN="placeholder_auth_token"
TWILIO_PHONE_NUMBER="+15005550006"

